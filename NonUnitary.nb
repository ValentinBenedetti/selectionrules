           RowBox[{"i", ",", "1", ",", "q"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "q"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "q"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"NNZq", "=", 
        RowBox[{
         RowBox[{"Re", "[", "NNdz", "]"}], "/", 
         RowBox[{"Re", "[", 
          RowBox[{"NNdz", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";", 
       "\n", 
       RowBox[{"Do", "[", 
