   RowBox[{
    RowBox[{"fusionZq", "[", "q_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"smatrixZq", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], "Pi", " ", "\[ImaginaryI]", " ", 
              RowBox[{"(", 
               RowBox[{"a", "-", "1"}], ")"}], 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"b", "-", "1"}], ")"}], "/", "q"}]}], "]"}], "/", 
            RowBox[{"Sqrt", "[", "q", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", "1", ",", "q"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", "1", ",", "q"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"smatrixZqc", "=", 
        RowBox[{"ConjugateTranspose", "[", "smatrixZq", "]"}]}], ";", 
       RowBox[{"NNdz", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"smatrixZq", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "u"}], "]"}], "]"}], 
             RowBox[{"smatrixZq", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "u"}], "]"}], "]"}], 
             RowBox[{
              RowBox[{"smatrixZqc", "[", 
               RowBox[{"[", 
                RowBox[{"u", ",", "k"}], "]"}], "]"}], "/", 
              RowBox[{"smatrixZq", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "u"}], "]"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"u", ",", "1", ",", "q"}], "}"}]}], "]"}], ",", 
