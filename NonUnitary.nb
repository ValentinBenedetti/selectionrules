Cell[CellGroupData[{

Cell["Non unitary su(2) WZW", "Title",
 CellChangeTimes->{{3.979818097317081*^9, 3.979818120726377*^9}, {
  3.979902840094852*^9, 
  3.979902856894404*^9}},ExpressionUUID->"4edd90a7-bdd6-48a3-942e-\
94c613ae33db"],

Cell["Modules premade", "Title",
 CellChangeTimes->{{3.979818097317081*^9, 
  3.979818120726377*^9}},ExpressionUUID->"09fd89bc-429e-4c71-8f26-\
b65a878093cc"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["verlinde[smatrix]: ",
  FontWeight->"Bold"],
 "the imput is an modular S matrix \[OpenCurlyDoubleQuote]smatrix\
\[CloseCurlyDoubleQuote] and the output fusion rules computed by verlinde \
formula  N_{ij}^{k} \
\[OpenCurlyDoubleQuote]NN[[i,j,k]]\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]aa\[CloseCurlyDoubleQuote] vector of  alphabetical \
fields with \[OpenCurlyDoubleQuote]NNN\[CloseCurlyDoubleQuote] of the form \
NN.aa "
}], "Item",
 CellChangeTimes->{{3.979818869892415*^9, 3.979818907300424*^9}, {
  3.9798189882313643`*^9, 
  3.979819055783523*^9}},ExpressionUUID->"7bdb9b90-f805-4e90-abb8-\
c15e38d61236"],

Cell[TextData[{
 StyleBox["dimensions[smatrix]: ",
  FontWeight->"Bold"],
 "the imput is an modular S matrix \[OpenCurlyDoubleQuote]smatrix\
\[CloseCurlyDoubleQuote] and the output is the list of quantum dimensions in \
\[OpenCurlyDoubleQuote]dims\[CloseCurlyDoubleQuote]"
}], "Item",
 CellChangeTimes->{
  3.979818980553947*^9, {3.9798190993211718`*^9, 
   3.979819117004274*^9}},ExpressionUUID->"e201eb92-9bb0-4d03-926d-\
244f7fa3a37e"],

Cell[TextData[{
 StyleBox["dimensionsbyfusion[NN]: ",
  FontWeight->"Bold"],
 "the imput are fusion rules \
\[OpenCurlyDoubleQuote]NN\[CloseCurlyDoubleQuote] and the output is the list \
of quantum dimensions in \[OpenCurlyDoubleQuote]dims\[CloseCurlyDoubleQuote] \
computed as the largest eigenvalue (in unitary theories should agree with \
dimensions but it is much slower)"
}], "Item",
 CellChangeTimes->{
  3.979818980553947*^9, {3.9798190993211718`*^9, 3.979819117004274*^9}, {
   3.979898648220681*^9, 
   3.979898713951241*^9}},ExpressionUUID->"d7fcdd87-224d-453d-95bc-\
a11cb0acbb6e"],

Cell[TextData[{
 StyleBox["submodels[fields,NNN]: ",
  FontWeight->"Bold"],
 "The imput is a list of aphabetical \[OpenCurlyDoubleQuote]fields\
\[CloseCurlyDoubleQuote] and their fusion product NNN[[i,j]]=Sum_k \
NN[[i,j,k]]fields[[k]] and the ouptut are the closed models in \
\[OpenCurlyDoubleQuote]models\[CloseCurlyDoubleQuote] numerically and  in \
\[OpenCurlyDoubleQuote]modelsaa\[CloseCurlyDoubleQuote] alphabetically \
Counter the number of iterations made to find all sumodels. The value of one \
means that each algebra can be generated with an unique primary"
}], "Item",
 CellChangeTimes->{{3.9798191210168*^9, 
  3.9798193023621893`*^9}},ExpressionUUID->"75e4a13f-95a2-4a96-b5ff-\
df3e0e371e28"],

Cell[TextData[{
 StyleBox["index[models,dims]:",
  FontWeight->"Bold"],
 " The imput is a list of numerical \[OpenCurlyDoubleQuote]models\
\[CloseCurlyDoubleQuote] and field quantum dimension \
\[OpenCurlyDoubleQuote]dims\[CloseCurlyDoubleQuote] and the output \
\[OpenCurlyDoubleQuote]modelsindex\[CloseCurlyDoubleQuote] the models ordered \
by global jones index (works only for diagonal models!)"
}], "Item",
 CellChangeTimes->{{3.979819313045477*^9, 3.979819369907906*^9}, {
  3.979881343625656*^9, 
  3.979881355549217*^9}},ExpressionUUID->"a0cd392b-9b85-4d87-924a-\
a64fb5c38c55"],

Cell[TextData[{
 StyleBox["looped[smatrix]: ",
  FontWeight->"Bold"],
 "the imput is an modular S matrix \[OpenCurlyDoubleQuote]smatrix\
\[CloseCurlyDoubleQuote]and the output \[OpenCurlyDoubleQuote]modelsindex\
\[CloseCurlyDoubleQuote] the models ordered by global jones index and all the \
outputs above"
}], "Item",
 CellChangeTimes->{{3.979819444448024*^9, 
  3.979819477795671*^9}},ExpressionUUID->"ba2569db-6d12-4d89-b1a4-\
589227d103bd"],

Cell[TextData[{
 StyleBox["loopednu[smatrix]: ",
  FontWeight->"Bold"],
 "the imput is an modular S matrix \[OpenCurlyDoubleQuote]smatrix\
\[CloseCurlyDoubleQuote]and the output \[OpenCurlyDoubleQuote]modelsindex\
\[CloseCurlyDoubleQuote] the models ordered by global jones index and all the \
outputs above with dimensions computed from \
\[OpenCurlyDoubleQuote]dimensionsbyfusion\[CloseCurlyDoubleQuote]"
}], "Item",
 CellChangeTimes->{{3.979898831162569*^9, 
  3.97989889205328*^9}},ExpressionUUID->"00513c92-ee77-485b-bcec-\
53773e68b0e9"],

Cell[TextData[{
 StyleBox["sameigen[NN1,NN2]:",
  FontWeight->"Bold"],
 " the imput is two set of fusion rules \[OpenCurlyDoubleQuote]NN1\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]NN2\
\[CloseCurlyDoubleQuote] and the autput their eigenvalues \
\[OpenCurlyDoubleQuote]e1\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]e2\[CloseCurlyDoubleQuote] and their difference \
printed or an error"
}], "Item",
 CellChangeTimes->{{3.979819691304372*^9, 3.979819696185862*^9}, {
  3.9798198624262753`*^9, 
  3.9798199595368147`*^9}},ExpressionUUID->"7b1e04ca-6ac3-4c21-a92f-\
8b4af95fd367"],

Cell[TextData[{
 StyleBox["fusionZq[q]: ",
  FontWeight->"Bold"],
 "the imput is an integer \[OpenCurlyDoubleQuote]q\[CloseCurlyDoubleQuote] \
and the output the S matrix of Zq smatrixZq and the fusion rules NNZq"
}], "Item",
 CellChangeTimes->{{3.979820167340184*^9, 3.979820239257758*^9}, {
  3.97982031032861*^9, 
  3.9798203104700413`*^9}},ExpressionUUID->"0e009b16-f47d-4e3e-904f-\
b50d7c8fa75d"],

Cell[TextData[{
 StyleBox["fusionsu2q[q_]: ",
  FontWeight->"Bold"],
 "given q generates the s matrix of su(2) level q in \
\[OpenCurlyDoubleQuote]smatrixsu2q\[CloseCurlyDoubleQuote], the fusion rules \
\[OpenCurlyDoubleQuote]NNsu2q\[CloseCurlyDoubleQuote], an alphabetical list \
of fields \[OpenCurlyDoubleQuote]aasu2q\[CloseCurlyDoubleQuote] and \
NNNsu2q=NNsu2q.aasu2q. It also generates the even counterparts of su(2) level \
q even in NNsu2qe, aasu2qe, and NNNsu2qe"
}], "Item",
 CellChangeTimes->{{3.979882860818612*^9, 
  3.979882861638126*^9}},ExpressionUUID->"088bc078-cde2-4a0a-b286-\
d4a6e514e0e6"],

Cell[TextData[{
 StyleBox["fusionprod[NN1,NN2]:",
  FontWeight->"Bold"],
 " the imput are two fusion rules and the output the product fusion rules"
}], "Item",
 CellChangeTimes->{{3.9798818037032948`*^9, 
  3.9798818317174587`*^9}},ExpressionUUID->"64ba0e6c-4542-483a-9327-\
1e940d51c424"],

Cell[TextData[{
 StyleBox["comuttinglines[lines,fields,smatrix]: ",
  FontWeight->"Bold"],
 "given a set of verlinde \
\[OpenCurlyDoubleQuote]lines\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote] fields\[CloseCurlyDoubleQuote] in numerical form as \
\[OpenCurlyDoubleQuote]models\[CloseCurlyDoubleQuote] and an \
\[OpenCurlyDoubleQuote]smatrix\[CloseCurlyDoubleQuote] this checks if the \
lines commute with the fields. If they do the output is 1 "
}], "Item",
 CellChangeTimes->{{3.9798826569628687`*^9, 3.979882858232863*^9}, {
  3.979883098653019*^9, 
  3.979883178784355*^9}},ExpressionUUID->"1d7da751-cac9-4f5f-ae77-\
626f6937eb20"],

Cell[TextData[{
 StyleBox["trim[NN,subset]: ",
  FontWeight->"Bold"],
 "the imput is a fusion rule \
\[OpenCurlyDoubleQuote]NN\[CloseCurlyDoubleQuote] and a \
\[OpenCurlyDoubleQuote]subset\[CloseCurlyDoubleQuote] of elements, the output \
are the fusion rules of the subset \[OpenCurlyDoubleQuote]NNtrim\
\[CloseCurlyDoubleQuote]"
}], "Item",
 CellChangeTimes->{{3.9798843857480173`*^9, 3.979884439383322*^9}, {
  3.979884631607242*^9, 
  3.9798846318673697`*^9}},ExpressionUUID->"6758057c-803f-40da-9030-\
57af8c466657"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"verlinde", "[", "smatrix_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"cut", "=", "0.1"}], ";", 
       RowBox[{"cut0", "=", "0.01"}], ";", 
       RowBox[{"cut1", "=", 
        RowBox[{"1", "-", "cut"}]}], ";", 
       RowBox[{"cut2", "=", 
        RowBox[{"1", "+", "cut"}]}], ";", 
       RowBox[{"sconjugate", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Conjugate", "[", 
          RowBox[{"N", "[", "smatrix", "]"}], "]"}], "]"}]}], ";", 
       RowBox[{"cc", "=", 
        RowBox[{"Length", "[", "smatrix", "]"}]}], ";", "\n", 
       RowBox[{"NNd", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"smatrix", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "u"}], "]"}], "]"}], 
              RowBox[{"smatrix", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", "u"}], "]"}], "]"}], 
              RowBox[{
               RowBox[{"sconjugate", "[", 
                RowBox[{"[", 
                 RowBox[{"u", ",", "k"}], "]"}], "]"}], "/", 
               RowBox[{"smatrix", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "u"}], "]"}], "]"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"u", ",", "1", ",", "cc"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "cc"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "cc"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "cc"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"NN", "=", 
        RowBox[{
         RowBox[{"Re", "[", "NNd", "]"}], "/", 
         RowBox[{"Re", "[", 
          RowBox[{"NNd", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";", 
       "\n", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"NN", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "]"}], ">", 
              "cut1"}], "&&", 
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"NN", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "]"}], ">", 
              "cut1", "<", "cut2"}]}], ",", 
            RowBox[{
             RowBox[{"NN", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", "1"}]}], 
           "]"}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"NN", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "]"}], "<", 
             "cut0"}], ",", 
            RowBox[{
             RowBox[{"NN", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "=", "0"}]}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "cc"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "cc"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "cc"}], "}"}]}], "]"}], ";", 
       RowBox[{"aa", "=", 
        RowBox[{"AlphabeticSort", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"\"\<a\>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "cc"}], "}"}]}], "]"}], "]"}]}], ";", 
       
       RowBox[{"NNN", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"NN", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j", ",", "m"}], "]"}], "]"}], 
              RowBox[{"aa", "[", 
               RowBox[{"[", "m", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "1", ",", "cc"}], "}"}]}], "]"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "cc"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "cc"}], "}"}]}], "]"}]}], ";"}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dimensions", "[", "smatrix_", "]"}], ":=", 
     RowBox[{"Module", "[", 
